
<!DOCTYPE html>
<html>
<head>
    <title>Add New Task</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('navbar')  %>
    <h1>Add New Task</h1>
    <div class="container">
        <% if (typeof error !== 'undefined' && error) { %>
            <p class="error"><%= error %></p>
        <% } %>
        <form action="/tasks" method="post">
            <label for="title">Title</label>
            <input id="title" name="title" type="text" placeholder="Enter task title" value="<%= typeof task !== 'undefined' ? task.title : '' %>" required>
            <label for="description">Description</label>
            <textarea name="description" id="description"><%= typeof task !== 'undefined' ? task.description : '' %></textarea>
            <button type="submit">Add task</button>
        </form>
    </div>
</body>
</html>
